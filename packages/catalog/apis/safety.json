{
 "engine": "safety",
 "_note": "Safety is the nurse in the field and the patient in trouble: visit check-in timers, panic with a time-bound live location, patient SOS, next-of-kin nomination and alerting, safeguarding reports, Sentinel deviations at tiers one to three, and the security incident register the identity service already keeps. Wave 2 contract; Waves 3 to 5 build.",
 "version": 1,
 "resources": ["checkins", "panics", "sos", "next-of-kin", "safeguarding-reports", "sentinel-deviations", "incident-kinds", "incidents"],
 "doors": ["emergency-acknowledgement"],
 "doorsToAdd": [],
 "refusals": [
  {"id": "dispatch-without-a-human", "status": 409, "statement": "Nothing is dispatched without a human, except for an unresponsive patient or an SOS.", "why": "High specificity for dispatching paramedics; a human confirms (§13)."},
  {"id": "consumer-wearable-raises-tier-four", "status": 422, "statement": "A consumer wearable alone never raises dispatch.", "why": "BYO signals guide conversation; certified devices carry clinical weight."},
  {"id": "next-of-kin-see-clinical-detail", "status": 422, "statement": "Next of kin see plain language, never clinical detail.", "why": "§15."},
  {"id": "location-kept-after-the-window", "status": 409, "statement": "A location is not kept after the incident window.", "why": "A safety feature that keeps positions is a tracking system."}
 ],
