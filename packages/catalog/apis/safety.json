    {"field": "dueAt", "type": "instant", "required": true, "why": "The new deadline."}
   ],
   "refusals": [
    {"id": "extension-limit", "status": 409, "statement": "That is as long as a visit can run without the desk calling.", "why": "An endless extension is a timer that never fires."}
