  {
   "method": "POST",
   "path": "/v1/safety/checkins",
   "version": 1,
   "summary": "Start a visit timer.",
   "callers": ["nurse", "locum", "responder"],
   "purpose": ["dispatch"],
   "request": [
    {"field": "idempotencyKey", "type": "string", "required": true, "why": "Chosen by the caller. The same key twice is the same act once."},
    {"field": "appointmentRef", "type": "string", "required": true, "why": "The visit timed."},
    {"field": "expectedMinutes", "type": "integer", "required": true, "why": "How long the visit should take."}
   ],
   "response": [
    {"field": "checkinRef", "type": "string", "required": true, "why": "The check-in."},
    {"field": "dueAt", "type": "instant", "required": true, "why": "When it goes overdue."}
   ],
   "refusals": [
    {"id": "visit-not-assigned", "status": 403, "statement": "That visit is not yours to time.", "why": "A timer belongs to the nurse at the door."}
   ],
   "emits": [],
   "emitsNoneBecause": "A timer emits checkin.overdue when it runs out, not when it starts.",
   "idempotent": true,
   "endpointNamed": null,
   "capabilityNamed": {"section": "FS-E4", "what": "Nurse safety suite: check-in timers"},
   "status": "proposed"
  },
  {
