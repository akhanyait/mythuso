   "callers": ["nurse", "locum", "responder"],
   "purpose": ["dispatch"],
   "request": [
    {"field": "idempotencyKey", "type": "string", "required": true, "why": "Chosen by the caller. The same key twice is the same act once."},
    {"field": "checkinRef", "type": "string", "required": true, "why": "The check-in."},
    {"field": "extraMinutes", "type": "integer", "required": true, "why": "How much longer."}
