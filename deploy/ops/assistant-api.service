# The assistant API: the service the web panel's bridge reaches, after an answer the matcher could
# not place, when an operator has configured a language-model provider — see
# apps/assistant-api/src/lib/llm-adapter.ts for what it may and may not do. It lives in deploy/ops/
# so the deploy installs it with the other units, and it is deliberately not enabled by it: its
# absence is the normal state of every deployment of this build.
#
# Neither state is an outage, which is why nothing here alerts on failure. With no provider set, the
# service answers exactly what the contract does; with the service down or unreachable, the panel
# falls back to the contract on the patient's own device and looks identical. The provider
# configuration — AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_KEY or AZURE_OPENAI_API_KEY,
# AZURE_OPENAI_MODEL, OLLAMA_URL, OLLAMA_MODEL — is read from /etc/mythuso/assistant.env, which
# deploy/ops/configure-assistant-env.sh writes (0600 root:root). The "-" on the EnvironmentFile is
# deliberate: the unit starts without it and answers providerless, because a unit that refuses to
# start over a file it does not need is a unit nobody can install.
#
# What runs is the esbuild bundle built by `npm run assistant-runtime` and published by the deploy to
# /opt/mythuso/assistant/server.mjs — a single Linux-neutral JavaScript file, so no node_modules is
# ever copied from a Mac or installed on the box. It is built for the Node floor in the root
# package.json's engines (22.12.0 at the time of writing); the deploy refuses to publish over a
# server whose Node is older, and an older Node handed the file anyway fails at startup — the
# bundle's syntax is that of the floor, so the process exits with a SyntaxError instead of running
# something half-parsed.
#
# The service holds nothing of a patient's at rest: sessions live in memory, no capture, transcript
# or answer is ever written, no socket is passed to it but the one it binds. DynamicUser= is that
# fact expressed as a unit directive — an ephemeral UID systemd allocates at start and forgets at
# stop, with no home and no reason to exist between runs. It implies ProtectSystem=strict and
# PrivateTmp= as defaults; they are written out below anyway, because the hardening should be
# readable here, not inferred. The EnvironmentFile is read by systemd as root before the privileges
# drop, which is what lets it stay 0600 root:root while the process it configures runs as nobody in
# particular.
#
# Since 28 September 2026 the service keeps three files of the founder's, and nothing else, in the
# StateDirectory below (packages/catalog/founder-access.json#state): the founder-signed settings
# history the speak route reads, the provider key vault (AES-256-GCM under MYTHUSO_VAULT_KEY from
# founder.env), and the founder audit. systemd creates /var/lib/mythuso-assistant, owns it for the
# dynamic user across restarts, and the process is told where it is in MYTHUSO_ASSISTANT_STATE_DIR;
# a process started without that variable reads the contract's defaults and refuses every founder
# write rather than keeping a change it would lose. Every file in it is 0600 (UMask below, and set
# again by the code that writes it). A deploy never touches the directory.
[Unit]
Description=MyThuso Assistant API (GilbertOne's second tier; dark until a model provider is configured)
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/mythuso/assistant
ExecStart=/usr/bin/node server.mjs
Environment=NODE_ENV=production
EnvironmentFile=-/etc/mythuso/assistant.env
# Founder access (packages/catalog/founder-access.json): the founder's password hash and authenticator
# secret, written by deploy/ops/configure-founder-access.sh (0600 root:root), and the enable line the
# founder adds by hand. Optional for the same reason as the line above: without it — every deployment's
# normal state — the service starts, and every founder route answers that founder access is switched
# off. Nothing a deploy does writes this file.
EnvironmentFile=-/etc/mythuso/founder.env
StateDirectory=mythuso-assistant
StateDirectoryMode=0700
Environment=MYTHUSO_ASSISTANT_STATE_DIR=%S/mythuso-assistant
Restart=on-failure
RestartSec=5

# The Azure key is in this process's memory and in its environment for as long as it runs — there
# is no way to hold a credential in a process without that. So the two places that memory could
# reach the disk are closed: a crash may not write a core file containing the key, and anything
# the service creates is readable only by the service. Neither of these stops root, and nothing in
# a unit file can; they stop the accident.
LimitCORE=0
UMask=0077

# It needs a listening socket, outbound HTTPS to the model provider, and nothing else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
