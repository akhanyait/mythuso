<?xml version="1.0" encoding="utf-8"?>
<!-- The one cleartext exception this build makes, and the only place it is written down: the
     assistant API on the emulator's host alias (10.0.2.2), where the service binds for local runs.
     Everything else stays TLS-only, exactly as android:usesCleartextTraffic="false" says, and the
     exception disappears with the flag that is the only thing allowed to use it. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
